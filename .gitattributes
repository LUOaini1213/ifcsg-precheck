# These self-authored demo outputs have raw-byte provenance, including CSV CRLF.
# Keep their exact generated bytes in Git on Windows and Linux.
demos/report-review/* -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Code and docs: LF everywhere, so Windows and Linux checkouts run the same bytes.
# IFC models, reports and summaries keep Git's default handling: their recorded
# provenance hashes describe the bytes as they were checked out at the time.
*.py text eol=lf
*.cjs text eol=lf
*.js text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.txt text eol=lf
